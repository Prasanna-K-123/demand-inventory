{
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Batch Id",
      "type": "string"
    },
    "events": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Events",
      "type": "array"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "start_offset": {
      "minimum": 0,
      "title": "Start Offset",
      "type": "integer"
    }
  },
  "required": [
    "batch_id",
    "source_sha256",
    "start_offset",
    "events"
  ],
  "title": "BatchRequest",
  "type": "object"
}